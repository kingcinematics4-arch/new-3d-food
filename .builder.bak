'use client';

import React, { useState, type CSSProperties, type ReactNode } from 'react';
import {
  CustomThemeConfig,
  DEFAULT_CUSTOM_THEME,
  TEMPLATE_PRESETS,
  FONT_OPTIONS,
  BORDER_RADIUS_OPTIONS,
  CARD_STYLE_OPTIONS,
  BUTTON_STYLE_OPTIONS,
  MENU_LAYOUT_OPTIONS,
} from '@/lib/customTheme';
import CustomTemplate from './templates/CustomTemplate';
import type { PublicMenuItem, PublicHotel, PublicCategory } from '@/app/menu/[slug]/MenuContent';
import type { Hotel } from '@/lib/useHotel';

interface CustomThemeBuilderProps {
  hotel: Hotel;
  initialConfig?: CustomThemeConfig | null;
  onSaved?: (config: CustomThemeConfig) => void;
  onCancel?: () => void;
  editingThemeId?: string;
  initialThemeName?: string;
}

const FIELD_LABEL: CSSProperties = {
  display: 'block',
  marginBottom: 6,
  fontSize: '0.75rem',
  fontWeight: 500,
  color: 'var(--text-secondary)',
  lineHeight: 1.35,
  whiteSpace: 'nowrap',
};

const TEXT_INPUT: CSSProperties = {
  width: '100%',
  minWidth: 0,
  borderRadius: 10,
  border: '1px solid var(--border-warm)',
  background: 'var(--bg-surface-2)',
  color: 'var(--text-primary)',
  padding: '0.625rem 0.75rem',
  fontSize: '0.8125rem',
  lineHeight: 1.4,
  outline: 'none',
};

function Section({
  number,
  title,
  children,
}: {
  number: string;
  title: string;
  children: ReactNode;
}) {
  return (
    <section className="flex flex-col gap-5">
      <div className="flex items-baseline gap-2.5">
        <span
          style={{
            fontSize: '0.625rem',
            fontWeight: 700,
            letterSpacing: '0.12em',
            color: 'var(--gold)',
            fontVariantNumeric: 'tabular-nums',
          }}
        >
          {number}
        </span>
        <h3
          style={{
            margin: 0,
            fontSize: '0.875rem',
            fontWeight: 600,
            color: 'var(--text-primary)',
            letterSpacing: '-0.01em',
            lineHeight: 1.3,
          }}
        >
          {title}
        </h3>
      </div>
      <div className="flex flex-col gap-5">{children}</div>
    </section>
  );
}

function ColorField({
  label,
  value,
  onChange,
}: {
  label: string;
  value: string;
  onChange: (v: string) => void;
}) {
  return (
    <div style={{ minWidth: 0 }}>
      <label style={FIELD_LABEL}>{label}</label>
      <div
        className="flex items-center gap-2.5"
        style={{
          borderRadius: 10,
          border: '1px solid var(--border-warm)',
          background: 'var(--bg-surface-2)',
          padding: '0.375rem 0.625rem',
        }}
      >
        <input
          type="color"
          value={value}
          onChange={(e) => onChange(e.target.value)}
          aria-label={label}
          style={{
            width: 34,
            height: 34,
            border: 'none',
            borderRadius: 8,
            padding: 0,
            background: 'transparent',
            cursor: 'pointer',
            flexShrink: 0,
          }}
        />
        <input
          type="text"
          value={value}
          onChange={(e) => onChange(e.target.value)}
          className="focus:outline-none"
          style={{
            flex: 1,
            minWidth: 0,
            border: 'none',
            background: 'transparent',
            color: 'var(--text-primary)',
            fontSize: '0.8125rem',
            fontFamily: 'ui-monospace, SFMono-Regular, Menlo, monospace',
            textTransform: 'uppercase',
            padding: 0,
          }}
        />
      </div>
    </div>
  );
}

function OptionTile({
  active,
  onClick,
  title,
  description,
}: {
  active: boolean;
  onClick: () => void;
  title: string;
  description: string;
}) {
  return (
    <button
      type="button"
      onClick={onClick}
      style={{
        textAlign: 'left',
        borderRadius: 10,
        border: `1px solid ${active ? 'var(--gold)' : 'var(--border-warm)'}`,
        background: active ? 'rgba(184,164,122,0.08)' : 'var(--bg-surface-2)',
        padding: '0.75rem 0.875rem',
        cursor: 'pointer',
        transition: 'border-color 150ms, background 150ms',
      }}
    >
      <span
        style={{
          display: 'block',
          fontSize: '0.8125rem',
          fontWeight: 600,
          color: 'var(--text-primary)',
          lineHeight: 1.3,
        }}
      >
        {title}
      </span>
      <span
        style={{
          display: 'block',
          marginTop: 3,
          fontSize: '0.6875rem',
          color: 'var(--text-muted)',
          lineHeight: 1.4,
        }}
      >
        {description}
      </span>
    </button>
  );
}

