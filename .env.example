# .env.example
# Copy this file to .env.local and replace the placeholder values with your actual Supabase credentials.
# Do NOT commit .env.local to version control.

NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Canonical public site URL.
# Used as the base of the redirect link inside Supabase confirmation emails, so
# it must exactly match an entry in Supabase -> Authentication -> URL
# Configuration -> Redirect URLs.
#   production: https://new-3d-food-jz4ddpgn2-kingcinematics4-7720s-projects.vercel.app
# Leave this UNSET for local development: the app then uses the request origin
# (http://localhost:3000) so local confirmation links keep working.
# NEXT_PUBLIC_SITE_URL=https://new-3d-food-jz4ddpgn2-kingcinematics4-7720s-projects.vercel.app
# NEXT_PUBLIC_APP_URL=https://new-3d-food-jz4ddpgn2-kingcinematics4-7720s-projects.vercel.app

# ============================================================
# DINE3D OWNER ADMIN PANEL (/admin)
# ============================================================
# Server-side only. NEVER prefix these with NEXT_PUBLIC_ — that would inline
# them into the browser bundle and expose them to every visitor.
#
# DINE3D_ADMIN_PASSWORD
#   The owner password for /admin. Compared on the server only; the browser
#   never receives or evaluates it. The admin panel stays locked and shows a
#   setup notice while this is unset.
#
# DINE3D_ADMIN_SESSION_SECRET
#   Optional. Signs the admin session cookie with HMAC-SHA256. Set it to a long
#   random string so the signing key can be rotated without changing the
#   password. If omitted, the key is derived from DINE3D_ADMIN_PASSWORD.
#
# Changing either value invalidates existing admin sessions.
DINE3D_ADMIN_PASSWORD=
DINE3D_ADMIN_SESSION_SECRET=
